# Environment variables for Tidy Guide Builder
# Copy this file to .env and fill in your actual API keys

# Digital Ocean Secret (for file storage)
DO_SECRET=your_digital_ocean_secret_here

# YouTube API Key (for video embedding features)
YOUTUBE_API=your_youtube_api_key_here

# Clerk Authentication (for user management)
VITE_CLERK_PUBLISHABLE_KEY=your_clerk_publishable_key_here

# AI API Keys (for content generation features)
OPENAI_API_KEY=your_openai_api_key_here
CLAUDE_API_KEY=your_claude_api_key_here

# Development Notes:
# - Never commit your actual .env file to version control
# - Get OpenAI keys from: https://platform.openai.com/api-keys
# - Get Anthropic Claude keys from: https://console.anthropic.com/
# - Get YouTube API keys from: https://console.developers.google.com/
# - Get Clerk keys from: https://dashboard.clerk.com/
# - Get Digital Ocean keys from: https://cloud.digitalocean.com/account/api/